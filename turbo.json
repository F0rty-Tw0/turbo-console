{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", "eslint.config.base.ts", ".nvmrc"],
  "globalPassThroughEnv": ["TMPDIR", "PLAYWRIGHT_BROWSERS_PATH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "turbo-console#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/LICENSE"]
    },
    "@turbo-console/tools#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/ci.yml",
        "$TURBO_ROOT$/.github/workflows/release.yml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/packages/webview-ui/playwright.screenshot.config.ts",
        "$TURBO_ROOT$/packages/webview-ui/package.json"
      ]
    },
    "@turbo-console/repo-gen#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json"]
    },
    "contract": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["TURBO_CONSOLE_MEASURE_RSS", "TURBO_CONSOLE_REAL_REPO", "TURBO_CONSOLE_STRESS"]
    },
    "e2e": {
      "dependsOn": ["build"]
    },
    "integration": {
      "dependsOn": ["build"],
      "cache": false
    },
    "bench": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
