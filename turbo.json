{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", "eslint.config.base.ts", ".nvmrc"],
  "globalPassThroughEnv": ["TMPDIR", "PLAYWRIGHT_BROWSERS_PATH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "contract": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["TURBO_CONSOLE_MEASURE_RSS", "TURBO_CONSOLE_REAL_REPO", "TURBO_CONSOLE_STRESS"]
    },
    "e2e": {
      "dependsOn": ["build"]
    },
    "integration": {
      "dependsOn": ["build"],
      "cache": false
    },
    "bench": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [".bench/**"]
    }
  }
}
