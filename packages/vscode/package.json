{
  "name": "turbo-console",
  "displayName": "Turbo Console (unofficial)",
  "version": "0.0.0",
  "description": "Unofficial VS Code extension for Turborepo",
  "private": true,
  "license": "MIT",
  "author": "Artiom Tofan artiomtofancv@gmail.com",
  "publisher": "turbo-console-dev",
  "type": "module",
  "engines": {
    "vscode": "^1.139.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:turbo.json",
    "workspaceContains:turbo.jsonc"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "turboConsole",
          "title": "Turbo Console",
          "icon": "$(package)"
        }
      ]
    },
    "views": {
      "turboConsole": [
        {
          "id": "turboConsole.commands",
          "name": "Common Commands",
          "when": "turboConsole.active"
        },
        {
          "id": "turboConsole.tree",
          "name": "Packages",
          "when": "turboConsole.active"
        },
        {
          "id": "turboConsole.help",
          "name": "Help and Feedback",
          "when": "turboConsole.active"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "turbo-console",
        "required": [
          "root",
          "id"
        ],
        "properties": {
          "root": {
            "type": "string",
            "description": "The workspace root turbo runs in."
          },
          "id": {
            "type": "string",
            "description": "The task id, for example @org/web#build."
          },
          "affected": {
            "type": "boolean",
            "description": "Run only the packages turbo finds affected."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "turboConsole.refresh",
        "title": "Refresh",
        "category": "Turbo Console",
        "icon": "$(refresh)"
      },
      {
        "command": "turboConsole.showFolders",
        "title": "Show as Folders",
        "category": "Turbo Console",
        "icon": "$(list-tree)"
      },
      {
        "command": "turboConsole.showList",
        "title": "Show as List",
        "category": "Turbo Console",
        "icon": "$(list-flat)"
      },
      {
        "command": "turboConsole.showScope",
        "title": "Show Package Scopes",
        "category": "Turbo Console",
        "icon": "$(eye)"
      },
      {
        "command": "turboConsole.hideScope",
        "title": "Hide Package Scopes",
        "category": "Turbo Console",
        "icon": "$(eye-closed)"
      },
      {
        "command": "turboConsole.showScripts",
        "title": "Show Scripts",
        "category": "Turbo Console",
        "icon": "$(list-filter)"
      },
      {
        "command": "turboConsole.hideScripts",
        "title": "Hide Scripts",
        "category": "Turbo Console",
        "icon": "$(filter-filled)"
      },
      {
        "command": "turboConsole.showOutput",
        "title": "Show Output",
        "category": "Turbo Console"
      },
      {
        "command": "turboConsole.runTask",
        "title": "Run Task",
        "category": "Turbo Console",
        "icon": "$(play)"
      },
      {
        "command": "turboConsole.runTaskWithoutCache",
        "title": "Run Task Without Cache",
        "category": "Turbo Console",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "turboConsole.stopTask",
        "title": "Stop Task",
        "category": "Turbo Console",
        "icon": "$(debug-stop)"
      },
      {
        "command": "turboConsole.runTaskPicker",
        "title": "Run Task…",
        "category": "Turbo Console"
      },
      {
        "command": "turboConsole.runPackageTask",
        "title": "Run Turbo Task…",
        "category": "Turbo Console",
        "icon": "$(play)"
      },
      {
        "command": "turboConsole.runEverywhere",
        "title": "Run Task in All Packages…",
        "category": "Turbo Console"
      },
      {
        "command": "turboConsole.runAffected",
        "title": "Run Affected…",
        "category": "Turbo Console"
      },
      {
        "command": "turboConsole.openLink",
        "title": "Open Link",
        "category": "Turbo Console"
      },
      {
        "command": "turboConsole.copyCommand",
        "title": "Copy Command",
        "category": "Turbo Console",
        "icon": "$(copy)"
      },
      {
        "command": "turboConsole.openPackageDetails",
        "title": "Open Package Details",
        "category": "Turbo Console",
        "icon": "$(open-preview)"
      },
      {
        "command": "turboConsole.openPackageJson",
        "title": "Open package.json",
        "category": "Turbo Console",
        "icon": "$(go-to-file)"
      },
      {
        "command": "turboConsole.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "Turbo Console"
      },
      {
        "command": "turboConsole.copyPath",
        "title": "Copy Path",
        "category": "Turbo Console"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "turboConsole.showScope",
          "when": "view == turboConsole.tree && !turboConsole.scopeShown",
          "group": "navigation@0"
        },
        {
          "command": "turboConsole.hideScope",
          "when": "view == turboConsole.tree && turboConsole.scopeShown",
          "group": "navigation@0"
        },
        {
          "command": "turboConsole.showScripts",
          "when": "view == turboConsole.tree && !turboConsole.scriptsShown",
          "group": "navigation@1"
        },
        {
          "command": "turboConsole.hideScripts",
          "when": "view == turboConsole.tree && turboConsole.scriptsShown",
          "group": "navigation@1"
        },
        {
          "command": "turboConsole.showFolders",
          "when": "view == turboConsole.tree && config.turboConsole.treeMode == list",
          "group": "navigation@2"
        },
        {
          "command": "turboConsole.showList",
          "when": "view == turboConsole.tree && config.turboConsole.treeMode != list",
          "group": "navigation@2"
        },
        {
          "command": "turboConsole.refresh",
          "when": "view == turboConsole.tree",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "turboConsole.runTask",
          "when": "view == turboConsole.tree && viewItem =~ /^turbo(Task|Script)(?!\\.running)/",
          "group": "inline@0"
        },
        {
          "command": "turboConsole.stopTask",
          "when": "view == turboConsole.tree && viewItem =~ /^turbo(Task|Script)\\.running/",
          "group": "inline@0"
        },
        {
          "command": "turboConsole.runTask",
          "when": "view == turboConsole.tree && viewItem =~ /^turbo(Task|Script)(?!\\.running)/",
          "group": "1_run@0"
        },
        {
          "command": "turboConsole.runTaskWithoutCache",
          "when": "view == turboConsole.tree && viewItem =~ /^turboTask(?!\\.running)/",
          "group": "1_run@1"
        },
        {
          "command": "turboConsole.stopTask",
          "when": "view == turboConsole.tree && viewItem =~ /^turbo(Task|Script)\\.running/",
          "group": "1_run@0"
        },
        {
          "command": "turboConsole.openPackageDetails",
          "when": "view == turboConsole.tree && viewItem == turboPackage",
          "group": "inline@0"
        },
        {
          "command": "turboConsole.openPackageJson",
          "when": "view == turboConsole.tree && viewItem == turboPackage",
          "group": "inline@1"
        },
        {
          "command": "turboConsole.copyCommand",
          "when": "view == turboConsole.tree && viewItem =~ /^turbo(Task|Script)/",
          "group": "inline@1"
        },
        {
          "command": "turboConsole.openPackageJson",
          "when": "view == turboConsole.tree && viewItem =~ /^turbo(Task|Script)/",
          "group": "inline@2"
        },
        {
          "command": "turboConsole.runTaskWithoutCache",
          "when": "view == turboConsole.tree && viewItem =~ /^turboTask\\.cached/",
          "group": "inline@3"
        },
        {
          "command": "turboConsole.openPackageDetails",
          "when": "view == turboConsole.tree && viewItem == turboPackage",
          "group": "2_open@0"
        },
        {
          "command": "turboConsole.openPackageJson",
          "when": "view == turboConsole.tree && viewItem == turboPackage",
          "group": "2_open@1"
        },
        {
          "command": "turboConsole.revealInExplorer",
          "when": "view == turboConsole.tree && viewItem == turboPackage",
          "group": "2_open@2"
        },
        {
          "command": "turboConsole.openPackageJson",
          "when": "view == turboConsole.tree && viewItem =~ /^turbo(Task|Script)/",
          "group": "2_open@1"
        },
        {
          "command": "turboConsole.copyCommand",
          "when": "view == turboConsole.tree && viewItem =~ /^turbo(Task|Script)/",
          "group": "3_copy"
        },
        {
          "command": "turboConsole.copyPath",
          "when": "view == turboConsole.tree && viewItem == turboPackage",
          "group": "3_copy"
        }
      ],
      "commandPalette": [
        {
          "command": "turboConsole.refresh",
          "when": "turboConsole.active"
        },
        {
          "command": "turboConsole.showFolders",
          "when": "turboConsole.active"
        },
        {
          "command": "turboConsole.showList",
          "when": "turboConsole.active"
        },
        {
          "command": "turboConsole.showScope",
          "when": "turboConsole.active && !turboConsole.scopeShown"
        },
        {
          "command": "turboConsole.hideScope",
          "when": "turboConsole.active && turboConsole.scopeShown"
        },
        {
          "command": "turboConsole.showScripts",
          "when": "turboConsole.active && !turboConsole.scriptsShown"
        },
        {
          "command": "turboConsole.hideScripts",
          "when": "turboConsole.active && turboConsole.scriptsShown"
        },
        {
          "command": "turboConsole.showOutput",
          "when": "turboConsole.active"
        },
        {
          "command": "turboConsole.runTask",
          "when": "false"
        },
        {
          "command": "turboConsole.runTaskWithoutCache",
          "when": "false"
        },
        {
          "command": "turboConsole.stopTask",
          "when": "false"
        },
        {
          "command": "turboConsole.runPackageTask",
          "when": "turboConsole.active && resourceFilename == package.json"
        },
        {
          "command": "turboConsole.openPackageDetails",
          "when": "turboConsole.active && resourceFilename == package.json"
        },
        {
          "command": "turboConsole.runTaskPicker",
          "when": "turboConsole.active"
        },
        {
          "command": "turboConsole.runEverywhere",
          "when": "turboConsole.active"
        },
        {
          "command": "turboConsole.runAffected",
          "when": "turboConsole.active"
        },
        {
          "command": "turboConsole.openLink",
          "when": "false"
        },
        {
          "command": "turboConsole.copyCommand",
          "when": "false"
        },
        {
          "command": "turboConsole.openPackageJson",
          "when": "false"
        },
        {
          "command": "turboConsole.revealInExplorer",
          "when": "false"
        },
        {
          "command": "turboConsole.copyPath",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "turboConsole.runPackageTask",
          "when": "turboConsole.active && resourceFilename == package.json",
          "group": "navigation"
        },
        {
          "command": "turboConsole.openPackageDetails",
          "when": "turboConsole.active && resourceFilename == package.json",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "turboConsole.runPackageTask",
          "when": "turboConsole.active && resourceFilename == package.json",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Turbo Console",
      "properties": {
        "turboConsole.turboPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the turbo binary to use instead of the workspace's own `node_modules/turbo`. Empty uses the workspace's turbo."
        },
        "turboConsole.treeMode": {
          "type": "string",
          "enum": [
            "folders",
            "list"
          ],
          "enumDescriptions": [
            "Packages grouped by their folders.",
            "Packages in one list, sorted by name."
          ],
          "default": "folders",
          "description": "How the Packages view lists packages."
        }
      }
    },
    "icons": {
      "turbo-console-angular": {
        "description": "Angular",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E001"
        }
      },
      "turbo-console-astro": {
        "description": "Astro",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E002"
        }
      },
      "turbo-console-biome": {
        "description": "Biome",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E003"
        }
      },
      "turbo-console-cypress": {
        "description": "Cypress",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E004"
        }
      },
      "turbo-console-docker": {
        "description": "Docker",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E005"
        }
      },
      "turbo-console-esbuild": {
        "description": "esbuild",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E006"
        }
      },
      "turbo-console-eslint": {
        "description": "ESLint",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E007"
        }
      },
      "turbo-console-jest": {
        "description": "Jest",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E008"
        }
      },
      "turbo-console-mocha": {
        "description": "Mocha",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E009"
        }
      },
      "turbo-console-next": {
        "description": "Next.js",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E00A"
        }
      },
      "turbo-console-nuxt": {
        "description": "Nuxt",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E00B"
        }
      },
      "turbo-console-prettier": {
        "description": "Prettier",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E00C"
        }
      },
      "turbo-console-rollup": {
        "description": "Rollup",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E00D"
        }
      },
      "turbo-console-storybook": {
        "description": "Storybook",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E00E"
        }
      },
      "turbo-console-svelte": {
        "description": "Svelte",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E00F"
        }
      },
      "turbo-console-typescript": {
        "description": "TypeScript",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E010"
        }
      },
      "turbo-console-vite": {
        "description": "Vite",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E011"
        }
      },
      "turbo-console-vitest": {
        "description": "Vitest",
        "default": {
          "fontPath": "./dist/webview/details/tool-icons.ttf",
          "fontCharacter": "\\E012"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --main-fields=module,main --minify --external:vscode --outfile=dist/extension.cjs && node -e \"const fs=require('node:fs');fs.rmSync('dist/webview/details',{recursive:true,force:true});fs.cpSync('../webview-ui/dist/details','dist/webview/details',{recursive:true})\" && node scripts/tool-icons.ts",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "bench": "node ../../tools/dist/run-benches.js",
    "integration": "esbuild \"test/suite/*.suite.ts\" --bundle --platform=node --format=cjs --target=node22 --main-fields=module,main --external:vscode --outdir=dist-test --out-extension:.js=.cjs && node -e \"require('node:fs').mkdirSync('.vsix',{recursive:true})\" && vsce package --no-dependencies --skip-license --allow-missing-repository --out .vsix/turbo-console.vsix && vsce ls --no-dependencies > .vsix/files.txt && node test/check-vsix.ts && node test/run-integration.ts"
  },
  "dependencies": {
    "@turbo-console/core": "workspace:*",
    "jsonc-parser": "catalog:runtime",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@turbo-console/repo-gen": "workspace:*",
    "@turbo-console/tools": "workspace:*",
    "@turbo-console/webview-ui": "workspace:*",
    "@types/svg2ttf": "catalog:dev",
    "@types/vscode": "1.138.0",
    "@vscode/test-electron": "catalog:dev",
    "@vscode/vsce": "catalog:dev",
    "simple-icons": "catalog:dev",
    "svg2ttf": "catalog:dev",
    "svgicons2svgfont": "catalog:dev",
    "turbo": "catalog:dev"
  }
}
