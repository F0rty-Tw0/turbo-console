{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "dist/lib"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/test/**", "src/**/*.spec.ts", "src/graph/**", "src/bridge/data-access/**", "src/bridge/common/bridge.type.ts"]
}
