{
  "name": "@turbo-console/webview-ui",
  "version": "0.0.0",
  "description": "Webview pages for Turbo Console",
  "private": true,
  "license": "MIT",
  "author": "Artiom Tofan artiomtofancv@gmail.com",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "cytoscape": "catalog:runtime",
    "elkjs": "catalog:runtime"
  },
  "devDependencies": {
    "@playwright/test": "catalog:dev",
    "@turbo-console/core": "workspace:*",
    "@vscode/codicons": "catalog:dev"
  }
}
