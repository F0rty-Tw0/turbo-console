{
  "extends": [
    "//"
  ],
  "tags": [
    "atomizer:definitions"
  ],
  "tasks": {
    "e2e-ci--tests/spec-001.spec.ts": {
      "command": [
        "node",
        "-e",
        "0"
      ],
      "dependsOn": [
        "^build",
        "e2e-ci-src--tests/spec-001.spec.ts"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.{spec,test}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
        "!**/*-snapshots/**"
      ],
      "tags": [
        "atomizer:e2e-ci"
      ]
    },
    "e2e-ci--tests/spec-002.live.spec.ts": {
      "command": [
        "node",
        "-e",
        "0"
      ],
      "dependsOn": [
        "^build",
        "e2e-ci-src--tests/spec-002.live.spec.ts"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.{spec,test}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
        "!**/*-snapshots/**"
      ],
      "cache": false,
      "tags": [
        "atomizer:e2e-ci",
        "atomizer:live"
      ]
    },
    "e2e-ci-src--tests/spec-001.spec.ts": {
      "command": [
        "node",
        "-e",
        "0"
      ],
      "inputs": [
        "tests/spec-001.spec.ts",
        "tests/spec-001.spec.ts-snapshots/**"
      ],
      "tags": [
        "atomizer:carrier"
      ]
    },
    "e2e-ci-src--tests/spec-002.live.spec.ts": {
      "command": [
        "node",
        "-e",
        "0"
      ],
      "inputs": [
        "tests/spec-002.live.spec.ts",
        "tests/spec-002.live.spec.ts-snapshots/**"
      ],
      "tags": [
        "atomizer:carrier"
      ]
    },
    "e2e-ci--all": {
      "dependsOn": [
        "e2e-ci--tests/spec-001.spec.ts",
        "e2e-ci--tests/spec-002.live.spec.ts"
      ]
    }
  }
}
